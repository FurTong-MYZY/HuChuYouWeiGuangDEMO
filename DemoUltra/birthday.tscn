[node name="Candles" type="Node2D" parent="WorldRoot"]

[node name="Candle0" type="Node2D" parent="WorldRoot/Candles"]
position = Vector2(300, 480)
script = ExtResource("4")
memory = "收容所里，你睁开眼，看见的是牢笼外的月光。那时你还不知道，世界会用这么大的声音迎接你。"

[node name="Candle1" type="Node2D" parent="WorldRoot/Candles"]
position = Vector2(540, 390)
script = ExtResource("4")
memory = "城区高处，你第一次看见雨幕里的整座城市，也第一次发现，原来自己可以跑得那么远。"
index = 1

[node name="Candle2" type="Node2D" parent="WorldRoot/Candles"]
position = Vector2(219.0275, 263.0021)
script = ExtResource("4")
memory = "霓虹雨夜之中，你没有回头。那些破碎的灯牌和积水里的倒影，都记得你走过的方向。"
index = 2

[node name="Candle3" type="Node2D" parent="WorldRoot/Candles"]
position = Vector2(823.89, 378.01266)
script = ExtResource("4")
memory = "警报声里，你没有停下。你开始明白，害怕并不是终点，向前一步才是。"
index = 3

[node name="Candle4" type="Node2D" parent="WorldRoot/Candles"]
position = Vector2(995.56024, 253.27695)
script = ExtResource("4")
memory = "谢谢你，感谢陪伴。愿这一年的所有疲惫，都在今晚的烛光里被轻轻接住。"
index = 4

