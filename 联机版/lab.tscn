offset_bottom = 19.285782
text = "…我们与兽人拥有高度相似的基因库。
有许多抑制表达的古老基因，
编码着人类拥有、后来在自然选择中逐渐退化的性状。
自然条件下，这些基因基本不可能激活…
"
label_settings = SubResource("LabelSettings_hsbix")
horizontal_alignment = 1

