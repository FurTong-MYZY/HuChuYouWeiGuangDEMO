[node name="Label" type="Label" parent="Area2D12"]
offset_left = -175.99998
offset_top = -206.99994
offset_right = 270.0
offset_bottom = -27.999939
text = "…从理论角度分析，
利用人工构建的“关键激活因子”，
以逆转录病毒载体批量导入，
并精准靶向沉默那些抑制古老基因表达的调控序列，
再配合体外诱导的胚胎期基因重编程技术，
理论上便可实现人的兽化…"
label_settings = SubResource("LabelSettings_hsbix")
horizontal_alignment = 1

